---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceHero from '../components/ServiceHero.astro';
---

<BaseLayout title="Google Ads | FoxePro">
  <ServiceHero 
    badge="Growth Focused"
    title="Google Ads Management"
    subtitle="Strategic paid search campaigns designed to maximize ROI and convert clicks into high-value customers."
  />

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-24 items-center">
        <div>
          <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-6">Efficiency First</h2>
          <p class="text-lg text-gray-600 leading-relaxed font-medium mb-10">
            We eliminate waste by targeting high-intent keywords and optimizing bids in real-time, ensuring every dollar of your ad spend is working toward your goals.
          </p>
          <div class="space-y-4">
            {[
              { t: "ROI Maximization", d: "Efficient allocation for highest returns." },
              { t: "Keyword Precision", d: "Targeting high-intent search terms." },
              { t: "Landing Page Sync", d: "Aligning ads with web experiences." }
            ].map(item => (
              <div class="p-6 bg-gray-50 rounded-2xl border border-gray-100 flex items-start space-x-4">
                <i class="ri-line-chart-line text-2xl text-primary mt-1"></i>
                <div>
                  <h4 class="font-black text-gray-900 uppercase tracking-tighter">{item.t}</h4>
                  <p class="text-gray-500 text-sm">{item.d}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-gray-950 rounded-[3rem] p-10 md:p-16 text-white relative overflow-hidden shadow-2xl">
          <div class="absolute top-0 right-0 w-64 h-64 bg-primary/20 blur-[100px] -mr-32 -mt-32"></div>
          <h3 class="text-2xl md:text-4xl font-black mb-10 relative z-10">Anticipated Results</h3>
          <div class="space-y-10 relative z-10">
            <div class="border-l-2 border-primary pl-6">
              <h4 class="text-xl font-bold mb-2">B2B Lead Gen</h4>
              <p class="text-gray-400 text-sm">Developing targeted campaigns to scale qualified lead volume significantly.</p>
            </div>
            <div class="border-l-2 border-secondary pl-6">
              <h4 class="text-xl font-bold mb-2">E-commerce Growth</h4>
              <p class="text-gray-400 text-sm">Optimizing Shopping and Search campaigns to improve ROAS drastically.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
