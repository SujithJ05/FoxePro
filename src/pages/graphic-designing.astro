---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import { Image } from 'astro:assets';

// Import portfolio images
import img1 from '../assets/input_file_0.jpeg';
import img2 from '../assets/input_file_1.jpeg';
import img3 from '../assets/input_file_2.jpeg';
import img4 from '../assets/input_file_3.jpeg';
import img5 from '../assets/input_file_4.jpeg';

const portfolio = [
  { img: img1, title: "Bindu Glam Artistry", category: "Logo Design" },
  { img: img2, title: "Prasanna Makeover", category: "Branding" },
  { img: img3, title: "Tharusha Healthy", category: "Visual Identity" },
  { img: img4, title: "YouTube Budget Sneakers", category: "Thumbnail Design" },
  { img: img5, title: "Akshara Pramanika", category: "Logo Design" }
];
---

<BaseLayout title="Graphic Designing | FoxePro">
  <ServiceHero 
    badge="Visual Excellence"
    title="Graphic Designing Services"
    subtitle="Elevate your brand with custom visuals designed to capture attention and communicate your unique identity."
  />

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-24">
        <div>
          <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-6">Our Design Philosophy</h2>
          <p class="text-lg text-gray-600 leading-relaxed font-medium mb-8">
            Good design is more than just aesthetics; it's about effective communication. We work closely with you to understand your vision and goals, translating them into compelling visuals.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {["Logos & Branding", "Social Media", "Thumbnails", "Marketing Assets"].map(item => (
              <div class="flex items-center space-x-3 p-4 bg-gray-50 rounded-2xl border border-gray-100">
                <i class="ri-checkbox-circle-fill text-primary"></i>
                <span class="font-bold text-gray-700">{item}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="relative group">
          <div class="absolute inset-0 bg-primary/10 blur-3xl rounded-full group-hover:bg-primary/20 transition-all"></div>
          <Image src={img1} alt="Philosophy" class="relative rounded-3xl shadow-2xl border border-gray-100 max-h-[400px] w-full object-cover" />
        </div>
      </div>

      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-4">Portfolio Samples</h2>
        <p class="text-lg text-gray-500">A glimpse into our visual storytelling capabilities.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {portfolio.map((item) => (
          <div class="group relative overflow-hidden rounded-3xl bg-gray-50 border border-gray-100 portfolio-card aspect-[4/3]">
            <Image 
              src={item.img} 
              alt={item.title}
              width={600}
              height={450}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-950/90 via-gray-950/20 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex flex-col justify-end p-8 text-white">
              <span class="text-primary font-bold text-[10px] uppercase tracking-widest mb-2">{item.category}</span>
              <h3 class="text-xl font-black">{item.title}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-8">Ready to visualize your brand?</h2>
      <a href={`${import.meta.env.BASE_URL}#contact`} class="inline-block bg-primary text-white px-10 py-4 rounded-2xl font-black uppercase tracking-widest text-[10px] hover:bg-blue-700 transition-all shadow-xl shadow-primary/20">
        Start a Project
      </a>
    </div>
  </section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    function initGraphicAnimations() {
      gsap.from(".portfolio-card", {
        scrollTrigger: { trigger: ".grid", start: "top 85%" },
        y: 40, opacity: 0, duration: 0.6, stagger: 0.1, ease: "power2.out"
      });
    }
    document.addEventListener('astro:page-load', initGraphicAnimations);
  </script>
</BaseLayout>
