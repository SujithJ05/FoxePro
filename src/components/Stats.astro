---
const stats = [
  { value: "50+", label: "Projects Delivered" },
  { value: "25M+", label: "Views Generated" },
  { value: "98%", label: "Client Retention" },
  { value: "3+", label: "Years Experience" },
];
---

<section class="py-12 border-y border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-950 transition-colors duration-500">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map((stat, index) => (
        <div class="text-center group" data-aos="fade-up" data-aos-delay={index * 100}>
          <h3 class="text-4xl md:text-5xl font-black text-gray-900 dark:text-white mb-2 group-hover:text-primary transition-colors cursor-default">
            {stat.value}
          </h3>
          <p class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>