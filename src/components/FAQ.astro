---
const faqs = [
  {
    question: "What exactly is FoxePro?",
    answer: "We are a next-generation creative agency startup focusing on high-impact digital assets. We combine top-tier creators with a tech-first approach to help startups and founders amplify their brand voice."
  },
  {
    question: "When will you be fully operational?",
    answer: "We are currently in our private beta phase. Our full suite of public services is scheduled for rollout soon. Join our waitlist to be the first to know!"
  },
  {
    question: "How does the waitlist work?",
    answer: "By joining the waitlist, you get priority access to our creative team, as well as exclusive early-bird pricing that won't be available to the general public."
  },
  {
    question: "Are you looking for more creative partners?",
    answer: "Always. If you are an elite Script Writer, Video Editor, or Graphic Designer, reach out to us via the contact section. We're building a collective of the best talent in the industry."
  }
];
---

<section id="faq" class="py-24 bg-white dark:bg-gray-950 transition-colors duration-500">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-16" data-aos="fade-up">
      <h2 class="text-3xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white">Common Questions</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400">Everything you need to know about FoxePro.</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="faq-item border border-gray-100 dark:border-gray-800 rounded-3xl overflow-hidden hover:border-primary/30 transition-colors" data-aos="fade-up" data-aos-delay={index * 100}>
          <button 
            class="faq-trigger w-full px-8 py-7 text-left flex justify-between items-center bg-gray-50/30 dark:bg-gray-900/50 hover:bg-gray-50 dark:hover:bg-gray-800 transition-all group"
          >
            <span class="text-xl font-black text-gray-800 dark:text-gray-200 tracking-tight">{faq.question}</span>
            <div class="w-10 h-10 rounded-full bg-white dark:bg-gray-800 flex items-center justify-center shadow-sm group-hover:bg-primary group-hover:text-white transition-all duration-300">
              <i class="ri-add-line text-xl transition-transform duration-500"></i>
            </div>
          </button>
          <div class="faq-content h-0 overflow-hidden bg-white dark:bg-gray-900">
            <div class="px-8 pb-8 pt-2">
              <p class="text-gray-500 dark:text-gray-400 leading-relaxed text-lg font-medium">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initFAQ() {
    const triggers = document.querySelectorAll('.faq-trigger');
    
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.faq-item');
        const content = item.querySelector('.faq-content');
        const icon = trigger.querySelector('i');
        const isOpen = item.classList.contains('active');

        // Close others
        document.querySelectorAll('.faq-item.active').forEach(otherItem => {
          if (otherItem !== item) {
            const otherContent = otherItem.querySelector('.faq-content');
            const otherIcon = otherItem.querySelector('i');
            gsap.to(otherContent, { height: 0, duration: 0.5, ease: "power4.inOut" });
            otherIcon.classList.remove('rotate-45');
            otherItem.classList.remove('active');
          }
        });

        // Toggle current
        if (isOpen) {
          gsap.to(content, { height: 0, duration: 0.5, ease: "power4.inOut" });
          icon.classList.remove('rotate-45');
          item.classList.remove('active');
        } else {
          gsap.set(content, { height: 'auto' });
          const fullHeight = content.offsetHeight;
          gsap.fromTo(content, { height: 0 }, { height: fullHeight, duration: 0.5, ease: "power4.out" });
          icon.classList.add('rotate-45');
          item.classList.add('active');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initFAQ);
</script>
