---
const faqs = [
  {
    question: "What exactly is FoxePro?",
    answer: "We are a next-generation creative agency startup focusing on high-impact digital assets. We combine top-tier creators with a tech-first approach to help startups and founders amplify their brand voice."
  },
  {
    question: "When will you be fully operational?",
    answer: "We are currently in our private beta phase. Our full suite of public services is scheduled for rollout soon. Join our waitlist to be the first to know!"
  },
  {
    question: "How does the waitlist work?",
    answer: "By joining the waitlist, you get priority access to our creative team, as well as exclusive early-bird pricing that won't be available to the general public."
  },
  {
    question: "Are you looking for more creative partners?",
    answer: "Always. If you are an elite Script Writer, Video Editor, or Graphic Designer, reach out to us via the contact section. We're building a collective of the best talent in the industry."
  }
];
---

<section id="faq" class="py-24 bg-white dark:bg-gray-950 transition-colors duration-500">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-16" data-aos="fade-up">
      <h2 class="text-3xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white">Common Questions</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400">Everything you need to know about FoxePro.</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden hover:border-primary/30 transition-colors" data-aos="fade-up" data-aos-delay={index * 100}>
          <button 
            class="w-full px-8 py-6 text-left flex justify-between items-center bg-gray-50/50 dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors group"
            onclick={`const content = this.nextElementSibling; const icon = this.querySelector('i'); content.classList.toggle('hidden'); icon.classList.toggle('rotate-180');`}
          >
            <span class="text-lg font-bold text-gray-800 dark:text-gray-200">{faq.question}</span>
            <i class="ri-arrow-down-s-line text-2xl text-gray-400 dark:text-gray-500 group-hover:text-primary transition-all"></i>
          </button>
          <div class="px-8 py-6 bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800 hidden">
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-lg">{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
