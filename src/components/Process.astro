---
const steps = [
  {
    number: "01",
    title: "Discovery",
    description: "We dive deep into your brand, target audience, and goals to create a tailored creative strategy.",
    icon: "ri-search-eye-line"
  },
  {
    number: "02",
    title: "Creation",
    description: "Our expert creators bring the vision to life, whether it's high-impact scripts, designs, or videos.",
    icon: "ri-magic-line"
  },
  {
    number: "03",
    title: "Delivery",
    description: "We refine the work based on your feedback and deliver polished assets ready to amplify your brand.",
    icon: "ri-rocket-2-line"
  }
];
---

<section id="process" class="py-24 bg-white dark:bg-gray-950 transition-colors duration-500">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white">How We Work</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">A streamlined process designed to deliver exceptional results with efficiency and transparency.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative">
      <!-- Connection Line (Desktop) -->
      <div class="hidden md:block absolute top-1/2 left-0 w-full h-0.5 bg-gray-100 dark:bg-gray-800 -translate-y-1/2 z-0"></div>
      
      {steps.map((step) => (
        <div class="relative z-10 flex flex-col items-center text-center group">
          <div class="w-20 h-20 bg-primary text-white rounded-2xl flex items-center justify-center mb-6 shadow-xl transform group-hover:scale-110 transition-transform duration-300">
            <i class={`${step.icon} text-3xl`}></i>
          </div>
          <div class="bg-white dark:bg-gray-900 px-4 transition-colors duration-500 rounded-xl">
            <span class="text-primary font-bold text-sm tracking-widest uppercase mb-2 block">{step.number}</span>
            <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">{step.title}</h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initProcessAnimations() {
    gsap.from("#process .group", {
      scrollTrigger: { 
        trigger: "#process", 
        start: "top 80%",
        once: true
      },
      y: 30, opacity: 0, duration: 0.8, stagger: 0.3
    });
  }
  document.addEventListener('astro:page-load', initProcessAnimations);
</script>
