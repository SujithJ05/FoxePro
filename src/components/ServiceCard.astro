---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  iconColor: string;
  order: number;
}

const { title, description, icon, href, iconColor, order } = Astro.props;
const formattedOrder = order.toString().padStart(2, '0');
---

<a href={import.meta.env.BASE_URL.replace(/\/$/, '') + href} class="service-card tilt-card group bg-white dark:bg-gray-900 p-10 rounded-[3rem] border border-gray-100 dark:border-gray-800 flex flex-col h-full hover:border-primary/20 dark:hover:border-primary/40 transition-all duration-500 shadow-sm hover:shadow-2xl overflow-hidden relative block" data-aos="fade-up">
  <div class="absolute top-8 right-10 text-[40px] font-black text-gray-50 dark:text-gray-800 opacity-0 group-hover:opacity-100 transition-opacity duration-700 select-none">
    {formattedOrder}
  </div>

  <div class="parallax-wrap mb-10 w-20 h-20">
    <div class={`parallax-img w-full h-full bg-gray-50 dark:bg-gray-800 rounded-2xl flex items-center justify-center shadow-inner group-hover:bg-primary/5 transition-colors duration-500`}>
      <i class={`${icon} ${iconColor} text-4xl group-hover:scale-110 transition-transform duration-500`}></i>
    </div>
  </div>
  
  <h3 class="text-2xl font-black mb-4 text-gray-900 dark:text-white group-hover:text-primary transition-colors tracking-tight">{title}</h3>
  <p class="text-gray-500 dark:text-gray-400 text-lg leading-relaxed mb-10 flex-grow font-medium">{description}</p>
  
  <div class="pt-8 border-t border-gray-50 dark:border-gray-800">
    <div class="text-gray-900 dark:text-white font-black text-[10px] uppercase tracking-widest flex items-center group-hover:gap-3 transition-all">
      Explore Case Study
      <i class="ri-arrow-right-up-line ml-2 text-primary group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"></i>
    </div>
  </div>
</a>
