---
const tools = [
  "Adobe Premiere Pro", "After Effects", "Figma", "Photoshop", "Illustrator", 
  "Google Ads", "Meta Business Suite", "DaVinci Resolve", "Three.js", "GSAP",
  "React", "Astro", "Tailwind CSS", "Copywriting", "Brand Strategy"
];
---

<div class="py-12 bg-white border-y border-gray-100 overflow-hidden select-none">
  <div class="flex flex-col space-y-8">
    <div class="flex whitespace-nowrap marquee-track">
      {[...tools, ...tools].map((tool) => (
        <div class="flex items-center space-x-4 mx-8">
          <span class="text-2xl md:text-3xl font-black text-gray-200 hover:text-primary transition-colors cursor-default uppercase tracking-tighter">
            {tool}
          </span>
          <div class="w-2 h-2 rounded-full bg-primary/20"></div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee 40s linear infinite;
    width: fit-content;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }
</style>
