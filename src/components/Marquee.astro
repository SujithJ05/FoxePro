---
const tools = [
  "Adobe Premiere Pro", "After Effects", "Figma", "Photoshop", "Illustrator", 
  "Google Ads", "Meta Business Suite", "DaVinci Resolve", "Three.js", "GSAP",
  "React", "Astro", "Tailwind CSS", "Copywriting", "Brand Strategy"
];
---

<div class="py-12 bg-white dark:bg-gray-950 border-y border-gray-100 dark:border-gray-800 overflow-hidden select-none transition-colors duration-500">
  <div class="flex flex-col space-y-8">
    <div class="flex whitespace-nowrap marquee-track">
      {[...tools, ...tools].map((tool) => (
        <div class="flex items-center space-x-4 mx-12 group/tool">
          <span class="text-3xl md:text-5xl font-black text-gray-100 dark:text-gray-900 group-hover/tool:text-primary transition-colors duration-500 cursor-default uppercase tracking-tighter">
            {tool}
          </span>
          <div class="w-3 h-3 rounded-full bg-primary/20 group-hover/tool:bg-primary transition-colors duration-500"></div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee 40s linear infinite;
    width: fit-content;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }
</style>
